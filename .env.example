# ---- Storage -------------------------------------------------------------
STORE_BACKEND=postgres            # postgres | memory
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# ---- Embeddings ----------------------------------------------------------
# hashing = offline & lexical (great for demos/tests)
# openai  = semantic embeddings from any OpenAI-compatible API
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384                 # must match the model (text-embedding-3-small = 1536)

# ---- LLM -----------------------------------------------------------------
# extractive = offline, returns the best-matching sentences with citations
# openai     = chat-completions API (OpenAI, Azure OpenAI, vLLM, Ollama, ...)
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Chunking & retrieval ------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
MIN_SCORE=0.1                     # chunks scoring below this are ignored

# ---- API -----------------------------------------------------------------
MAX_UPLOAD_MB=20
API_KEY=                          # set to require an X-API-Key header on all endpoints except /health
